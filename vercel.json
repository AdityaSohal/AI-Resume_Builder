{
  "version": 2,
  "buildCommand": "cd client && npm install && npm run build",
  "outputDirectory": "client/dist",
  "installCommand": "cd server && npm install",
  "framework": null,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "server/server.js" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "functions": {
    "server/server.js": {
      "runtime": "nodejs20.x"
    }
  }
}